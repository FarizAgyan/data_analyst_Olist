      <aliases enabled='yes' />
      <column caption='By_Year' datatype='real' name='[Calculation_1300132926978002944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Order&quot; THEN COUNTD([order_id] )&#13;&#10;WHEN &quot;Value&quot; THEN SUM([payment_value])&#13;&#10;WHEN &quot;Review&quot; THEN AVG([review_score])&#13;&#10;END' />
      </column>
      <column caption='DATE' datatype='integer' name='[Calculation_1300132927082491907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Tahun&quot; THEN DATEPART(&apos;year&apos;, [order_purchase_timestamp])&#13;&#10;WHEN &quot;Bulan&quot; THEN DATEPART(&apos;month&apos;, [order_purchase_timestamp])&#13;&#10;WHEN &quot;Tanggal&quot; THEN DATEPART(&apos;day&apos;, [order_purchase_timestamp])&#13;&#10;END' />
      </column>
      <column caption='New Customer' datatype='boolean' name='[Calculation_161848121541316609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [customer_unique_id] : MIN([order_purchase_timestamp]) } = [order_purchase_timestamp]' />
